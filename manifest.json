{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.2.0",
  "default_locale": "en",
  "description": "Download media exposed by webpages or use bundled local yt-dlp and FFmpeg tools for supported sites.",
  "permissions": ["activeTab", "downloads", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:8765/*"],
  "action": {"default_title": "Video Downloader", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}